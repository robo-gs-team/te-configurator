{% comment %}
  Proto Switcher Configurator — App Embed
  Enable via Theme Editor > App embeds > Proto Configurator
  Loads the configurator modal script globally on the storefront.
{% endcomment %}

{%- comment -%}
  Scope: only emit on PRODUCT pages. The app embed is global — Shopify injects it into
  theme.liquid on EVERY page of the store — but there is nothing for it to do off a product page:
  no product to link, no button to place, no share to restore. Without this guard, home /
  collection / cart / blog / search / 404 pages ALL downloaded our JS + CSS (and evaluated the
  inline styles) for nothing. Guarding here means every non-product page ships ZERO of our code.

  Which product templates count as racquets is merchant-editable (below), so adding a new racquet
  template does not require a code change and a deploy.

  BLANK MUST NEVER MEAN "EVERYWHERE". That was the original bug in both directions: first as a
  freeform field whose blank default loaded the configurator on every PDP, then as a checkbox
  whose schema default silently did not apply to themes saved before the setting existed (Liquid
  read nil, nil is falsy, the restriction was skipped). Both failed OPEN, and non-racquet product
  pages started carrying our JS. Here an empty or absent value falls back to the built-in racquet
  list, so the worst case of a missing/lost/never-configured setting is "correctly scoped", never
  "loaded on the whole catalogue". Loading everywhere is possible, but only by typing `all`.
{%- endcomment -%}
{%- assign proto_default_templates = 'racquet, racquet-pdp-v2' -%}
{%- assign proto_should_load = false -%}
{%- if block.settings.enabled and request.page_type == 'product' -%}
  {%- assign proto_templates = block.settings.product_templates | default: '' | strip -%}
  {%- if proto_templates == blank -%}
    {%- assign proto_templates = proto_default_templates -%}
  {%- endif -%}
  {%- assign proto_templates = proto_templates | downcase -%}

  {%- if proto_templates == 'all' -%}
    {%- assign proto_should_load = true -%}
  {%- else -%}
    {%- comment -%} A product on the standard template reports a blank suffix. {%- endcomment -%}
    {%- if template.suffix != blank -%}
      {%- assign proto_suffix = template.suffix | downcase | strip -%}
    {%- else -%}
      {%- assign proto_suffix = 'default' -%}
    {%- endif -%}
    {%- comment -%}
      Liquid allows no filters inside a `for` collection or an `if` condition, so both the split
      and the per-entry strip have to be assigned first.
    {%- endcomment -%}
    {%- assign proto_allowed = proto_templates | split: ',' -%}
    {%- for proto_t in proto_allowed -%}
      {%- assign proto_t_trim = proto_t | strip -%}
      {%- if proto_t_trim == proto_suffix -%}
        {%- assign proto_should_load = true -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}

{% if proto_should_load %}
  {% comment %}
    Release channel (Stable/Beta). Per-theme setting: the live/published theme should stay on
    "stable" (the frozen, known-good bundle), while a draft/duplicate theme can be set to "beta" to
    run the latest code without touching the live theme. Both bundles ship in the extension; this
    only picks which one THIS theme loads. See package.json build:storefront:beta / promote:stable.
  {% endcomment %}
  {% assign proto_channel = block.settings.channel | default: 'stable' %}
  {% if proto_channel == 'beta' %}
    {% assign proto_js = 'proto-configurator.beta.js' %}
    {% assign proto_css = 'proto-configurator.beta.css' %}
    {% assign proto_modal = 'proto-configurator-modal.beta.js' %}
  {% else %}
    {% assign proto_js = 'proto-configurator.js' %}
    {% assign proto_css = 'proto-configurator.css' %}
    {% assign proto_modal = 'proto-configurator-modal.js' %}
  {% endif %}

  <script>
    document.documentElement.classList.add('proto-configurator-pending');
  </script>
  <script>
    window.ProtoConfiguratorSettings = {
      appProxyUrl: {{ block.settings.app_proxy_url | default: '/apps/proto-configurator' | json }},
      productId: {{ product.id | default: '' | json }},
      shopDomain: {{ shop.permanent_domain | default: shop.domain | json }},
      channel: {{ proto_channel | json }},
      modalUrl: {{ proto_modal | asset_url | json }}
    };
    /* Perf: start the LINKAGE-ONLY fetch NOW, during HTML parse, instead of after the deferred
       bundle downloads + executes — the App Proxy round-trip overlaps page load. This hits the
       lightweight `/link` endpoint (~100 bytes: just "is this product linked?"), NOT the full
       string catalog — the full catalog is fetched separately by the bundle only once the
       shopper shows real intent (hover/touch/click), so a page load that never leads to a click
       never pays for it. The bundle consumes this promise for its first attempt
       (entry.tsx#fetchLinkage) and falls back to its own retrying fetch if it's absent or failed. */
    (function () {
      try {
        var s = window.ProtoConfiguratorSettings;
        if (s && s.productId) {
          var q = s.shopDomain ? '?shop=' + encodeURIComponent(s.shopDomain) : '';
          window.ProtoConfiguratorEarlyFetch = window.fetch(
            s.appProxyUrl + '/product/' + s.productId + '/link' + q,
            { credentials: 'same-origin', headers: { Accept: 'application/json' } }
          );
          /* Swallow here so an offline/failed early fetch never surfaces as an unhandled
             rejection; the bundle re-fetches with retries on its own. */
          window.ProtoConfiguratorEarlyFetch.catch(function () {});
        }
      } catch (e) { /* no-op — bundle fetches normally */ }
    })();
  </script>
  <script src="{{ proto_js | asset_url }}" defer></script>
  {{ proto_css | asset_url | stylesheet_tag }}

  <style>
    #proto-configurator-root {
      position: relative;
      z-index: 99999;
    }

    /* Fallback when JS marks body — hide Buy now only (quantity stays visible) */
    body.proto-stringing-strung .shopify-payment-button,
    body.proto-stringing-strung shopify-accelerated-checkout,
    body.proto-stringing-strung .shopify-buy-it-now-button {
      display: none !important;
    }

    .proto-configurator-actions--inline {
      margin-top: 0 !important;
      grid-area: buy-buttons;
      align-self: stretch;
      --button-border-radius: 8px;
      min-width: 0;
      width: 100%;
      display: flex !important;
      flex-direction: column;
      justify-content: flex-end;
      position: relative;
      z-index: 40;
      pointer-events: auto;
    }

    .proto-configurator-actions--inline .proto-configurator-trigger {
      width: 100%;
      border-radius: var(--button-border-radius, 8px) !important;
      min-height: 48px !important;
      height: 48px !important;
      max-height: 48px !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      box-sizing: border-box !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      pointer-events: auto !important;
      position: relative;
      z-index: 31;
    }

    /* Configure in its own row above quantity + ATC — never replaces Add to cart. */
    html[data-proto-v2-strung] .product-configurator-quantity-buy-buttons,
    html[data-proto-v2-strung] .thb-product-detail .product-configurator-quantity-buy-buttons {
      grid-template-areas:
        "configurator configurator"
        "proto-configure proto-configure"
        "quantity buy-buttons" !important;
      grid-template-columns: 1fr 2fr;
    }

    html[data-proto-v2-strung] .product-quantity-buy-buttons:not(.product-configurator-quantity-buy-buttons),
    html[data-proto-v2-strung] .thb-product-detail .product-quantity-buy-buttons:not(.product-configurator-quantity-buy-buttons) {
      grid-template-areas:
        "proto-configure proto-configure"
        "quantity buy-buttons" !important;
      grid-template-columns: 1fr 2fr;
    }

    .proto-v2-standalone-wrapper.proto-v2-below-dropdown,
    .proto-v2-standalone-wrapper.proto-v2-inline-slot {
      margin-top: 8px !important;
      margin-bottom: 12px !important;
      grid-area: proto-configure !important;
      width: 100%;
      max-width: 100%;
      align-self: stretch;
      --button-border-radius: 8px;
      min-width: 0;
      visibility: visible !important;
      display: flex !important;
      flex-direction: column;
      justify-content: flex-start;
      position: relative;
      z-index: 200;
      pointer-events: auto !important;
      isolation: isolate;
    }

    .proto-v2-below-dropdown .proto-v2-configure-trigger,
    .proto-v2-inline-slot .proto-v2-configure-trigger {
      width: 100% !important;
      border-radius: var(--button-border-radius, 8px) !important;
      min-height: 48px !important;
      height: 48px !important;
      max-height: 48px !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      box-sizing: border-box !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      pointer-events: auto !important;
      position: relative;
      z-index: 31;
    }

    /* Hide theme legacy Configure only — Add to cart stays visible. */
    html[data-proto-v2-strung] button[name="configure"],
    html[data-proto-v2-strung] #ProductPopup-Configurator,
    html[data-proto-v2-strung] #ProductPopup-Configurator-Hybrid,
    html[data-proto-v2-strung] .product-popup-modal__opener[data-modal*="Configurator"],
    html[data-proto-v2-atc-slot] button[name="configure"],
    html[data-proto-v2-atc-slot] #ProductPopup-Configurator,
    html[data-proto-v2-atc-slot] #ProductPopup-Configurator-Hybrid,
    html[data-proto-v2-atc-slot] .product-popup-modal__opener[data-modal*="Configurator"] {
      display: none !important;
      pointer-events: none !important;
    }

    .proto-configurator-button-wrapper {
      margin: 12px 0;
      width: 100%;
      max-width: 100%;
      position: relative;
      z-index: 20;
      isolation: isolate;
    }

    .product__info .proto-configurator-button-wrapper,
    #ProductInfo .proto-configurator-button-wrapper,
    .product-info .proto-configurator-button-wrapper {
      margin-top: 8px;
      margin-bottom: 12px;
    }

    .proto-configurator-field {
      margin-bottom: 12px;
    }

    .proto-configurator-label {
      display: block;
      margin-bottom: 8px;
      font-size: 14px;
      font-weight: 600;
      color: inherit;
    }

    .proto-configurator-select-wrap {
      position: relative;
    }

    .proto-configurator-select-wrap::after {
      content: '';
      position: absolute;
      top: 50%;
      right: 16px;
      width: 0;
      height: 0;
      pointer-events: none;
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      border-top: 6px solid currentColor;
      transform: translateY(-25%);
      opacity: 0.65;
    }

    .proto-configurator-select {
      appearance: none;
      -webkit-appearance: none;
      width: 100%;
      min-height: 48px;
      padding: 12px 44px 12px 16px;
      border: 1px solid rgba(0, 0, 0, 0.15);
      border-radius: 4px;
      background: #fff;
      color: inherit;
      font: inherit;
      line-height: 1.4;
      cursor: pointer;
    }

    .proto-configurator-select:focus {
      outline: 2px solid rgba(59, 130, 246, 0.45);
      outline-offset: 1px;
    }

    .proto-configurator-actions[hidden] {
      display: none !important;
    }

    .proto-configurator-actions {
      position: relative;
      z-index: 21;
    }

    .proto-configurator-trigger {
      position: relative;
      z-index: 22;
      pointer-events: auto !important;
      cursor: pointer !important;
    }

    html.proto-configurator-pending .proto-configurator-button-wrapper {
      visibility: hidden;
    }

    html.proto-configurator-unlinked .proto-configurator-button-wrapper {
      display: none !important;
    }

    html[data-proto-stringing-state="unstrung"] [data-proto-configurator-actions],
    html[data-proto-stringing-state="unstrung"] .proto-configurator-trigger {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Proto Configurator",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable configurator",
      "default": true
    },
    {
      "type": "select",
      "id": "channel",
      "label": "Version",
      "default": "stable",
      "options": [
        { "value": "stable", "label": "Stable (recommended for your live theme)" },
        { "value": "beta", "label": "Beta (latest — for a test/draft theme only)" }
      ],
      "info": "Stable = the frozen, tested bundle. Beta = the latest build, for trying new changes on a draft theme without affecting your live theme. Set Beta ONLY on a duplicate/test theme."
    },
    {
      "type": "text",
      "id": "product_templates",
      "label": "Racquet product templates",
      "default": "racquet, racquet-pdp-v2",
      "info": "Comma-separated product template names the configurator loads on — everything else (shoes, apparel, bags) loads none of its code. Leave blank to use the built-in racquet templates. Use 'default' for the standard product template, or 'all' to load on every product page (not recommended: it adds weight to non-racquet pages)."
    },
    {
      "type": "text",
      "id": "app_proxy_url",
      "label": "App proxy URL",
      "default": "/apps/proto-configurator",
      "info": "Default app proxy path. Change only if customized in Partners dashboard."
    }
  ]
}
{% endschema %}
